# Get a free key at https://aistudio.google.com  -- never commit the real .env
GEMINI_API_KEY=your_key_here
# Optional: primary model and fallbacks (used when a model is retired or overloaded)
RR_MODEL=gemini-3.8-flash
RR_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite
# Optional: raises the GitHub API limit for the repo-size check from 60 to 5000/hour
GITHUB_TOKEN=
